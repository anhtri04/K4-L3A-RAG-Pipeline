# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: opencode | openai | gemini | anthropic
LLM_PROVIDER=opencode
LLM_MODEL=muse-spark-1.3-contributor

# Opencode Zen (OpenAI-compatible Responses API).
# Base URL đầy đủ dạng responses: https://opencode.ai/zen/go/v1/responses
# SDK base_url chỉ lấy tới .../v1 (code tự strip đuôi /responses).
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Generation providers khác
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=

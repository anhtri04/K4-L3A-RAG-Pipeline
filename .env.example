# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic | extractive
LLM_PROVIDER=openai
LLM_MODEL=deepseek-chat

# Generation providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: hash | sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-1024
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.3